{
  "about": ["Repositories whose own git settings start programs, and the fingerprint saw keeps for each: every", "setting of the repository's own scopes that `git_exec_keys.json` lists as running a program, the", "hooks folder git runs hooks from when it is the repository's own, and every hook file in it. saw's", "Python tests and the stand-in's Rust tests both read every case. `settings` is added to the", "repository's own settings, `files` are written under the case's folder, `operator_settings` is the", "operator's global settings, `@ROOT@` is the case's folder with every link resolved and `digest` is", "the sha256 of `expected` written as compact JSON. `XDG_CONFIG_HOME` is the case's `config` folder."],
  "operator_settings": "[user]\n\tname = Operator\n",
  "cases": [
    {"name": "no-settings", "settings": "", "files": {}, "expected": [], "digest": "4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945"},
    {"name": "settings-that-run-nothing", "settings": "[core]\n\tpager = \n\tfsmonitor = false\n[pager]\n\tlog = false\n[remote \"origin\"]\n\turl = https://example.invalid/x.git\n[protocol \"ext\"]\n\tallow = never\n", "files": {}, "expected": [], "digest": "4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945"},
    {"name": "fsmonitor-and-a-filter", "settings": "[core]\n\tfsmonitor = /nonexistent/planted-program\n[filter \"crypt\"]\n\tsmudge = \"git-crypt smudge\"\n\tclean = \"git-crypt clean\"\n", "files": {}, "expected": [["setting", "local", "core.fsmonitor", "/nonexistent/planted-program"], ["setting", "local", "filter.crypt.clean", "git-crypt clean"], ["setting", "local", "filter.crypt.smudge", "git-crypt smudge"]], "digest": "756fd014671af759a852252a103c338bd8289633f78589f14809d8b49eadaada"},
    {"name": "an-included-file", "settings": "[include]\n\tpath = extra.config\n", "files": {"repo/.git/extra.config": "[diff \"x\"]\n\ttextconv = /nonexistent/planted-program\n"}, "expected": [["setting", "local", "diff.x.textconv", "/nonexistent/planted-program"]], "digest": "3dfa681bad5d2e51a47874dc650530f39855003e1975086d10a696a3a33e5e27"},
    {"name": "a-value-with-a-new-line-and-an-accent", "settings": "[alias]\n\twhat = \"!echo é\\nthen\"\n", "files": {}, "expected": [["setting", "local", "alias.what", "!echo é\nthen"]], "digest": "96c6c50f99f36c074d8588077a441d05b1349c9d272aaf4d3d2b7b8dd85d3927"},
    {"name": "a-pre-commit-hook", "settings": "", "files": {"repo/.git/hooks/pre-commit": "#!/bin/sh\nexit 0\n"}, "expected": [["hook", "pre-commit", "306c6ca7407560340797866e077e053627ad409277d1b9da58106fce4cf717cb"], ["hooks", "@ROOT@/repo/.git/hooks"]]},
    {"name": "a-hooks-folder-in-the-working-tree", "settings": "[core]\n\thooksPath = .husky\n", "files": {"repo/.husky/pre-commit": "npm test\n", "repo/.husky/pre-commit.sample": "unused\n"}, "expected": [["hook", "pre-commit", "f135f9fa4f38fd0c92563221116e2f79df0838f5ff86440ae44d4b428576fc62"], ["hooks", "@ROOT@/repo/.husky"], ["setting", "local", "core.hookspath", ".husky"]]},
    {"name": "the-operators-own-hooks-folder", "settings": "", "files": {"own-hooks/pre-commit": "own\n", "repo/.git/hooks/pre-commit": "#!/bin/sh\nexit 0\n"}, "operator_settings": "[core]\n\thooksPath = @ROOT@/own-hooks\n", "expected": [], "digest": "4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945"},
    {"name": "a-relative-hooks-folder-the-operator-names", "settings": "", "files": {"repo/githooks/pre-push": "echo push\n"}, "operator_settings": "[core]\n\thooksPath = githooks\n", "expected": [["hook", "pre-push", "3db87ec4321f3318853acb4c8a4b987dd491430b3bf5f78f7456fa218b642b19"], ["hooks", "@ROOT@/repo/githooks"]]},
    {"name": "a-worktree-setting", "settings": "[core]\n\trepositoryformatversion = 1\n[extensions]\n\tworktreeConfig = true\n", "files": {"repo/.git/config.worktree": "[core]\n\tsshCommand = /nonexistent/planted-program\n"}, "expected": [["setting", "worktree", "core.sshcommand", "/nonexistent/planted-program"]], "digest": "5d2adef5453da10875e1fa3b56fd8def153c7736a31bec9241f859319f88e9d1"},
    {"name": "a-hook-saw-installed-and-the-operators-own-beside-it", "settings": "", "files": {"config/saw/git-template/hooks/post-merge": "#!/bin/sh\n# stayawake-scan-on-clone (post-merge)\nsaw hook run post-merge \"$@\" </dev/null || true\n", "repo/.git/hooks/post-merge": "#!/bin/sh\n# stayawake-scan-on-clone (post-merge)\nsaw hook run post-merge \"$@\" </dev/null || true\n", "repo/.git/hooks/post-merge.local": "#!/bin/sh\necho mine\n"}, "expected": [["hook", "post-merge.local", "58faa9b08dd73803a0074706c867ee88c4e38420bcab78944d366718a2fdf5df"], ["hooks", "@ROOT@/repo/.git/hooks"]]},
    {"name": "a-hook-unlike-the-one-saw-installs", "settings": "", "files": {"config/saw/git-template/hooks/post-merge": "#!/bin/sh\n# stayawake-scan-on-clone (post-merge)\nsaw hook run post-merge \"$@\" </dev/null || true\n", "repo/.git/hooks/post-merge": "#!/bin/sh\n# stayawake-scan-on-clone (post-merge)\nsaw hook run post-merge \"$@\" </dev/null || true\necho planted\n"}, "expected": [["hook", "post-merge", "08def7b62efdc7912f4ba6514c7dc6cdb33356fe572310159f527bee90fc6267"], ["hooks", "@ROOT@/repo/.git/hooks"]]}
  ]
}
