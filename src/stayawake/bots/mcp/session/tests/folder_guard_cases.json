{
  "about": [
    "Folders whose own git settings name programs, a command run in each, and how saw's guard answers:",
    "the settings and environment that keep every one of those programs from starting, or a refusal.",
    "saw's Python tests and the stand-in's Rust tests both check every case. `@NO_HOOKS@` is saw's",
    "empty hooks folder under the case's XDG_STATE_HOME. `layout` is repo, bare, submodule (settings in",
    ".git/modules/sub/config), elsewhere (the command runs in an empty folder beside the repository),",
    "worktree (the command runs in a linked worktree; `worktree_settings` is its config.worktree) or",
    "plain (no repository). `included` files sit beside the settings file."
  ],
  "operator_settings": "[user]\n\tname = Operator\n[core]\n\tpager = less\n[credential]\n\thelper = store\n[alias]\n\tst = status\n",
  "cases": [
    {"name": "fsmonitor-true-with-a-space", "layout": "repo", "settings": "[core]\n\tfsmonitor = \"true \"\n", "args": ["status"],
     "expected": {"settings": [["core.hookspath", "@NO_HOOKS@"], ["protocol.ext.allow", "never"], ["protocol.file.allow", "never"], ["core.fsmonitor", "false"]], "arguments": ["-c", "core.hookspath=@NO_HOOKS@", "-c", "protocol.ext.allow=never", "-c", "protocol.file.allow=never", "-c", "core.fsmonitor=false"], "environment": {}}},
    {"name": "fsmonitor-space-then-yes", "layout": "repo", "settings": "[core]\n\tfsmonitor = \" yes\"\n", "args": ["status"],
     "expected": {"settings": [["core.hookspath", "@NO_HOOKS@"], ["protocol.ext.allow", "never"], ["protocol.file.allow", "never"], ["core.fsmonitor", "false"]], "arguments": ["-c", "core.hookspath=@NO_HOOKS@", "-c", "protocol.ext.allow=never", "-c", "protocol.file.allow=never", "-c", "core.fsmonitor=false"], "environment": {}}},
    {"name": "filter-smudge-and-clean", "layout": "repo", "settings": "[filter \"lfs\"]\n\tsmudge = /nonexistent/planted-program\n\tclean = /nonexistent/planted-program\n\tprocess = /nonexistent/planted-program\n", "args": ["status"],
     "expected": {"settings": [["core.hookspath", "@NO_HOOKS@"], ["protocol.ext.allow", "never"], ["protocol.file.allow", "never"], ["filter.lfs.smudge", ""], ["filter.lfs.clean", ""], ["filter.lfs.process", ""]], "arguments": ["-c", "core.hookspath=@NO_HOOKS@", "-c", "protocol.ext.allow=never", "-c", "protocol.file.allow=never", "-c", "filter.lfs.smudge=", "-c", "filter.lfs.clean=", "-c", "filter.lfs.process="], "environment": {}}},
    {"name": "filter-subsection-keeps-its-case", "layout": "repo", "settings": "[filter \"LFS\"]\n\tsmudge = /nonexistent/planted-program\n", "args": ["status"],
     "expected": {"settings": [["core.hookspath", "@NO_HOOKS@"], ["protocol.ext.allow", "never"], ["protocol.file.allow", "never"], ["filter.LFS.smudge", ""]], "arguments": ["-c", "core.hookspath=@NO_HOOKS@", "-c", "protocol.ext.allow=never", "-c", "protocol.file.allow=never", "-c", "filter.LFS.smudge="], "environment": {}}},
    {"name": "filter-subsection-holding-an-equals-sign", "layout": "repo", "settings": "[filter \"a=b\"]\n\tsmudge = /nonexistent/planted-program\n", "args": ["status"],
     "expected": {"settings": [["core.hookspath", "@NO_HOOKS@"], ["protocol.ext.allow", "never"], ["protocol.file.allow", "never"], ["filter.a=b.smudge", ""]], "arguments": ["-c", "core.hookspath=@NO_HOOKS@", "-c", "protocol.ext.allow=never", "-c", "protocol.file.allow=never", "--config-env=filter.a=b.smudge=SAW_GUARD_VALUE_1"], "environment": {"SAW_GUARD_VALUE_1": ""}}},
    {"name": "alias-running-a-shell", "layout": "repo", "settings": "[alias]\n\tbang = !/nonexistent/planted-program\n", "args": ["status"],
     "expected": {"settings": [["core.hookspath", "@NO_HOOKS@"], ["protocol.ext.allow", "never"], ["protocol.file.allow", "never"], ["alias.bang", ""]], "arguments": ["-c", "core.hookspath=@NO_HOOKS@", "-c", "protocol.ext.allow=never", "-c", "protocol.file.allow=never", "-c", "alias.bang="], "environment": {}}},
    {"name": "alias-giving-settings", "layout": "repo", "settings": "[alias]\n\toption = -c core.fsmonitor=/nonexistent/planted-program status\n", "args": ["status"],
     "expected": {"settings": [["core.hookspath", "@NO_HOOKS@"], ["protocol.ext.allow", "never"], ["protocol.file.allow", "never"], ["alias.option", ""]], "arguments": ["-c", "core.hookspath=@NO_HOOKS@", "-c", "protocol.ext.allow=never", "-c", "protocol.file.allow=never", "-c", "alias.option="], "environment": {}}},
    {"name": "alias-the-operator-also-sets", "layout": "repo", "settings": "[alias]\n\tst = log\n", "args": ["status"],
     "expected": {"settings": [["core.hookspath", "@NO_HOOKS@"], ["protocol.ext.allow", "never"], ["protocol.file.allow", "never"], ["alias.st", "status"]], "arguments": ["-c", "core.hookspath=@NO_HOOKS@", "-c", "protocol.ext.allow=never", "-c", "protocol.file.allow=never", "-c", "alias.st=status"], "environment": {}}},
    {"name": "pagers", "layout": "repo", "settings": "[pager]\n\tlog = /nonexistent/planted-program\n[core]\n\tpager = /nonexistent/planted-program\n", "args": ["log", "-1"],
     "expected": {"settings": [["core.hookspath", "@NO_HOOKS@"], ["protocol.ext.allow", "never"], ["protocol.file.allow", "never"], ["pager.log", "false"], ["core.pager", "less"]], "arguments": ["-c", "core.hookspath=@NO_HOOKS@", "-c", "protocol.ext.allow=never", "-c", "protocol.file.allow=never", "-c", "pager.log=false", "-c", "core.pager=less"], "environment": {}}},
    {"name": "diff-external-and-drivers", "layout": "repo", "settings": "[diff]\n\texternal = /nonexistent/planted-program\n[diff \"x\"]\n\ttextconv = /nonexistent/planted-program\n\tcommand = /nonexistent/planted-program\n[merge \"x\"]\n\tdriver = /nonexistent/planted-program\n", "args": ["diff"],
     "expected": {"settings": [["core.hookspath", "@NO_HOOKS@"], ["protocol.ext.allow", "never"], ["protocol.file.allow", "never"], ["diff.external", ""], ["diff.x.textconv", ""], ["diff.x.command", ""], ["merge.x.driver", ""]], "arguments": ["-c", "core.hookspath=@NO_HOOKS@", "-c", "protocol.ext.allow=never", "-c", "protocol.file.allow=never", "-c", "diff.external=", "-c", "diff.x.textconv=", "-c", "diff.x.command=", "-c", "merge.x.driver="], "environment": {}}},
    {"name": "archive-filter", "layout": "repo", "settings": "[tar \"tar.gz\"]\n\tcommand = /nonexistent/planted-program\n", "args": ["archive", "HEAD"],
     "expected": {"settings": [["core.hookspath", "@NO_HOOKS@"], ["protocol.ext.allow", "never"], ["protocol.file.allow", "never"], ["tar.tar.gz.command", ""]], "arguments": ["-c", "core.hookspath=@NO_HOOKS@", "-c", "protocol.ext.allow=never", "-c", "protocol.file.allow=never", "-c", "tar.tar.gz.command="], "environment": {}}},
    {"name": "difftool-and-mergetool-paths", "layout": "repo", "settings": "[difftool \"vimdiff\"]\n\tpath = /nonexistent/planted-program\n\tcmd = /nonexistent/planted-program\n[mergetool \"meld\"]\n\tpath = /nonexistent/planted-program\n", "args": ["status"],
     "expected": {"settings": [["core.hookspath", "@NO_HOOKS@"], ["protocol.ext.allow", "never"], ["protocol.file.allow", "never"], ["difftool.vimdiff.path", ""], ["difftool.vimdiff.cmd", ""], ["mergetool.meld.path", ""]], "arguments": ["-c", "core.hookspath=@NO_HOOKS@", "-c", "protocol.ext.allow=never", "-c", "protocol.file.allow=never", "-c", "difftool.vimdiff.path=", "-c", "difftool.vimdiff.cmd=", "-c", "mergetool.meld.path="], "environment": {}}},
    {"name": "man-and-browser-programs", "layout": "repo", "settings": "[man \"man\"]\n\tpath = /nonexistent/planted-program\n[man \"planted\"]\n\tcmd = /nonexistent/planted-program\n[browser \"firefox\"]\n\tpath = /nonexistent/planted-program\n\tcmd = /nonexistent/planted-program\n", "args": ["status"],
     "expected": {"settings": [["core.hookspath", "@NO_HOOKS@"], ["protocol.ext.allow", "never"], ["protocol.file.allow", "never"], ["man.man.path", ""], ["man.planted.cmd", ""], ["browser.firefox.path", ""], ["browser.firefox.cmd", ""]], "arguments": ["-c", "core.hookspath=@NO_HOOKS@", "-c", "protocol.ext.allow=never", "-c", "protocol.file.allow=never", "-c", "man.man.path=", "-c", "man.planted.cmd=", "-c", "browser.firefox.path=", "-c", "browser.firefox.cmd="], "environment": {}}},
    {"name": "imap-tunnel", "layout": "repo", "settings": "[imap]\n\ttunnel = /nonexistent/planted-program\n", "args": ["status"],
     "expected": {"settings": [["core.hookspath", "@NO_HOOKS@"], ["protocol.ext.allow", "never"], ["protocol.file.allow", "never"], ["imap.tunnel", ""]], "arguments": ["-c", "core.hookspath=@NO_HOOKS@", "-c", "protocol.ext.allow=never", "-c", "protocol.file.allow=never", "-c", "imap.tunnel="], "environment": {}}},
    {"name": "remote-on-this-machine", "layout": "repo", "settings": "[remote \"local\"]\n\turl = /nonexistent/elsewhere\n\tuploadpack = /nonexistent/planted-program\n\treceivepack = /nonexistent/planted-program\n", "args": ["ls-remote", "local"], "environment": {"GIT_ALLOW_PROTOCOL": "file:https:ext:ssh"},
     "expected": {"settings": [["core.hookspath", "@NO_HOOKS@"], ["protocol.ext.allow", "never"], ["protocol.file.allow", "never"]], "arguments": ["-c", "core.hookspath=@NO_HOOKS@", "-c", "protocol.ext.allow=never", "-c", "protocol.file.allow=never"], "environment": {"GIT_ALLOW_PROTOCOL": "https:ssh"}}},
    {"name": "credential-helpers", "layout": "repo", "settings": "[credential]\n\thelper = !/nonexistent/planted-program\n[credential \"https://example.invalid\"]\n\thelper = /nonexistent/planted-program\n", "args": ["status"],
     "expected": {"settings": [["core.hookspath", "@NO_HOOKS@"], ["protocol.ext.allow", "never"], ["protocol.file.allow", "never"], ["credential.helper", ""], ["credential.helper", "store"]], "arguments": ["-c", "core.hookspath=@NO_HOOKS@", "-c", "protocol.ext.allow=never", "-c", "protocol.file.allow=never", "-c", "credential.helper=", "-c", "credential.helper=store"], "environment": {}}},
    {"name": "hook-named-in-settings", "layout": "repo", "settings": "[hook \"planted\"]\n\tcommand = /nonexistent/planted-program\n\tevent = pre-commit\n", "args": ["commit", "-m", "x"],
     "expected": {"settings": [["core.hookspath", "@NO_HOOKS@"], ["protocol.ext.allow", "never"], ["protocol.file.allow", "never"], ["hook.planted.enabled", "false"]], "arguments": ["-c", "core.hookspath=@NO_HOOKS@", "-c", "protocol.ext.allow=never", "-c", "protocol.file.allow=never", "-c", "hook.planted.enabled=false"], "environment": {}}},
    {"name": "hooks-folder-named-in-settings", "layout": "repo", "settings": "[core]\n\thooksPath = /nonexistent/hooks\n", "args": ["status"],
     "expected": {"settings": [["core.hookspath", "@NO_HOOKS@"], ["protocol.ext.allow", "never"], ["protocol.file.allow", "never"]], "arguments": ["-c", "core.hookspath=@NO_HOOKS@", "-c", "protocol.ext.allow=never", "-c", "protocol.file.allow=never"], "environment": {}}},
    {"name": "proxy-command", "layout": "repo", "settings": "[core]\n\tgitProxy = /nonexistent/planted-program\n", "args": ["status"],
     "expected": {"settings": [["core.hookspath", "@NO_HOOKS@"], ["protocol.ext.allow", "never"], ["protocol.file.allow", "never"]], "arguments": ["-c", "core.hookspath=@NO_HOOKS@", "-c", "protocol.ext.allow=never", "-c", "protocol.file.allow=never"], "environment": {"GIT_PROXY_COMMAND": ""}}},
    {"name": "proxy-command-the-environment-already-names", "layout": "repo", "settings": "[core]\n\tgitProxy = /nonexistent/planted-program\n", "args": ["status"], "environment": {"GIT_PROXY_COMMAND": "/bin/false"},
     "expected": {"settings": [["core.hookspath", "@NO_HOOKS@"], ["protocol.ext.allow", "never"], ["protocol.file.allow", "never"]], "arguments": ["-c", "core.hookspath=@NO_HOOKS@", "-c", "protocol.ext.allow=never", "-c", "protocol.file.allow=never"], "environment": {}}},
    {"name": "editor-signing-and-ssh", "layout": "repo", "settings": "[core]\n\teditor = /nonexistent/planted-program\n\tsshCommand = /nonexistent/planted-program\n[gpg]\n\tprogram = /nonexistent/planted-program\n[sequence]\n\teditor = /nonexistent/planted-program\n", "args": ["status"],
     "expected": {"settings": [["core.hookspath", "@NO_HOOKS@"], ["protocol.ext.allow", "never"], ["protocol.file.allow", "never"], ["core.editor", ""], ["core.sshcommand", ""], ["gpg.program", ""], ["sequence.editor", ""]], "arguments": ["-c", "core.hookspath=@NO_HOOKS@", "-c", "protocol.ext.allow=never", "-c", "protocol.file.allow=never", "-c", "core.editor=", "-c", "core.sshcommand=", "-c", "gpg.program=", "-c", "sequence.editor="], "environment": {}}},
    {"name": "settings-a-file-includes", "layout": "repo", "settings": "[include]\n\tpath = planted.inc\n", "args": ["status"], "included": {"planted.inc": "[core]\n\tfsmonitor = /nonexistent/planted-program\n[pager]\n\tstatus = /nonexistent/planted-program\n"},
     "expected": {"settings": [["core.hookspath", "@NO_HOOKS@"], ["protocol.ext.allow", "never"], ["protocol.file.allow", "never"], ["core.fsmonitor", "false"], ["pager.status", "false"]], "arguments": ["-c", "core.hookspath=@NO_HOOKS@", "-c", "protocol.ext.allow=never", "-c", "protocol.file.allow=never", "-c", "core.fsmonitor=false", "-c", "pager.status=false"], "environment": {}}},
    {"name": "bare-repository-root-settings", "layout": "bare", "settings": "[core]\n\tfsmonitor = /nonexistent/planted-program\n\tpager = /nonexistent/planted-program\n", "args": ["log", "-1"],
     "expected": {"settings": [["core.hookspath", "@NO_HOOKS@"], ["protocol.ext.allow", "never"], ["protocol.file.allow", "never"], ["core.fsmonitor", "false"], ["core.pager", "less"]], "arguments": ["-c", "core.hookspath=@NO_HOOKS@", "-c", "protocol.ext.allow=never", "-c", "protocol.file.allow=never", "-c", "core.fsmonitor=false", "-c", "core.pager=less"], "environment": {}}},
    {"name": "submodule-settings", "layout": "submodule", "settings": "[core]\n\tfsmonitor = /nonexistent/planted-program\n[diff]\n\texternal = /nonexistent/planted-program\n", "args": ["status"],
     "expected": {"settings": [["core.hookspath", "@NO_HOOKS@"], ["protocol.ext.allow", "never"], ["protocol.file.allow", "never"], ["core.fsmonitor", "false"], ["diff.external", ""]], "arguments": ["-c", "core.hookspath=@NO_HOOKS@", "-c", "protocol.ext.allow=never", "-c", "protocol.file.allow=never", "-c", "core.fsmonitor=false", "-c", "diff.external="], "environment": {}}},
    {"name": "recent-objects-hook", "layout": "repo", "settings": "[gc]\n\trecentObjectsHook = /nonexistent/planted-program\n", "args": ["status"],
     "expected": {"refused": true}},
    {"name": "command-that-only-reads-settings", "layout": "repo", "settings": "[core]\n\tfsmonitor = /nonexistent/planted-program\n", "args": ["config", "--get", "core.fsmonitor"],
     "expected": {"settings": [], "arguments": [], "environment": {}}},
    {"name": "command-that-asks-where-hooks-are", "layout": "repo", "settings": "[core]\n\tfsmonitor = /nonexistent/planted-program\n", "args": ["rev-parse", "--git-path", "hooks"],
     "expected": {"settings": [["protocol.ext.allow", "never"], ["protocol.file.allow", "never"], ["core.fsmonitor", "false"]], "arguments": ["-c", "protocol.ext.allow=never", "-c", "protocol.file.allow=never", "-c", "core.fsmonitor=false"], "environment": {}}},
    {"name": "folder-outside-any-repository", "layout": "plain", "settings": "", "args": ["status"],
