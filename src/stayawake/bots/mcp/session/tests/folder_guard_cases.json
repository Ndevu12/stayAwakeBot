    {"name": "working-tree-the-environment-names", "layout": "elsewhere", "settings": "[core]\n\tfsmonitor = /nonexistent/planted-program\n[diff]\n\texternal = /nonexistent/planted-program\n", "args": ["status"], "environment": {"GIT_DIR": "../repo/.git", "GIT_WORK_TREE": "../repo"},
